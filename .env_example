# CatSeek R1 — real BitNet b1.58 (no OpenAI / no cloud LLM)
MODEL="microsoft/bitnet-b1.58-2B-4T"
SUMMARIZER_MODEL="microsoft/bitnet-b1.58-2B-4T"
BITNET_BITS=1.58
BITNET_HOME="/Users/catsanzshftw/BitNet"
BITNET_GGUF="models/BitNet-b1.58-2B-4T/ggml-model-i2_s.gguf"
BITNET_BACKEND=auto
BITNET_THREADS=7
BITNET_TEMP=0.7
BITNET_N_PREDICT=256
ENABLE_CRITIC=false
PROMPT_USER=true

MAX_CONTEXT_SIZE=4000
MAX_MEMORY_ITEM_SIZE=2000
SUMMARIZER_CHUNK_SIZE=3000

WORK_DIR=
DEBUG=false

FILES_OFF=true
MAX_STEPS=12
REASONING_EFFORT=64
